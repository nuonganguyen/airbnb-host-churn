		toColumn: dim_k.k

	ref table fact_precision

		measure 'Host precision' = AVERAGE(fact_precision[host_precision])
			formatString: 0.0%

		measure 'LightGBM precision' = CALCULATE(AVERAGE(fact_precision[host_precision]), fact_precision[model] = "lgbm")
			formatString: 0.0%

		measure 'Best rule precision' = CALCULATE(AVERAGE(fact_precision[host_precision]), fact_precision[model] = "rule:low_presence_365")
			formatString: 0.0%

		measure 'Lift over best rule' = CALCULATE(AVERAGE(fact_precision[host_precision]), fact_precision[model] = "lgbm") - CALCULATE(AVERAGE(fact_precision[host_precision]), fact_precision[model] = "rule:low_presence_365")
			formatString: 0.0%

		measure 'Extra at-risk hosts' = (CALCULATE(AVERAGE(fact_precision[host_precision]), fact_precision[model] = "lgbm") - CALCULATE(AVERAGE(fact_precision[host_precision]), fact_precision[model] = "rule:low_presence_365")) * SELECTEDVALUE(dim_k[k])
			formatString: 0

	ref table fact_business

		measure 'Strategy precision' = AVERAGE(fact_business[precision])
			formatString: 0.0%

		measure 'Captured value share' = AVERAGE(fact_business[captured_share])
			formatString: 0.0%

	ref table fact_model_quality

		measure 'LightGBM overprediction' = CALCULATE(AVERAGE(fact_model_quality[mean_pred]) - AVERAGE(fact_model_quality[base_rate]), fact_model_quality[model] = "lgbm")
			formatString: 0.0%

	ref table fact_feature_gain

		measure 'Gain share' = AVERAGE(fact_feature_gain[gain_share])
			formatString: 0.0%
